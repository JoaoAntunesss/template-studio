{
  "rules": {
    ".read": false,
    ".write": false,

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "reservas": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["dataExata"],
      "$id": {
        ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.exists())",
        ".validate": "newData.hasChildren(['dataExata','hora','blocos','servicoNome','preco','clienteNome','clienteTelemovel']) && ((auth != null && root.child('admins').child(auth.uid).val() === true) || (newData.child('estadoPagamento').val() === 'A Pagar no Dia' && newData.child('status').val() === 'ativo' && newData.child('mensagemEnviada').val() === false))",
        "dataExata": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
        "hora": { ".validate": "newData.isString() && newData.val().matches(/^\\d{2}:\\d{2}$/)" },
        "blocos": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 24" },
        "preco": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "clienteNome": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
        "clienteTelemovel": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "clienteEmail": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "clienteNif": { ".validate": "newData.isString() && newData.val().length <= 20" },
        "servicoNome": { ".validate": "newData.isString() && newData.val().length <= 120" }
      }
    },

    "ocupacao": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$dia": {
        "$hora": {
          ".write": "(auth != null && root.child('admins').child(auth.uid).val() === true) || (!data.exists() && newData.isString() && newData.parent().parent().parent().child('reservas').child(newData.val()).exists())"
        }
      }
    },

    "precos":     { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "bloqueios":  { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "config":     { ".read": true, ".write": "auth != null && root.child('admins').child(auth.uid).val() === true" },
    "notificacoes": { ".read": "auth != null && root.child('admins').child(auth.uid).val() === true", ".write": false }
  }
}
